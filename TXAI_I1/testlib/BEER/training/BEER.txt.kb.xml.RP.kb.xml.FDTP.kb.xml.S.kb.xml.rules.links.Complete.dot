	Rule5 [shape=circle,height=3.050,width=3.050,fixedsize=true,peripheries=2,color="#ff8c00",fillcolor="#ff8c00",fontsize=15.399999618530273,fontcolor=black,style=filled,label="R5\n (cov=0.205) \n (G= 0.554) \n (CBarleywine=1.000)",tooltip="Rule5:  IF Color is Straw OR Amber AND Strength is Very high THEN Class is Barleywine (cov=0.205 ; G= 0.554 ; CBarleywine=1.000)"];
	Rule6 [shape=circle,height=3.725,width=3.725,fixedsize=true,peripheries=2,color="#d2691e",fillcolor="#d2691e",fontsize=15.399999618530273,fontcolor=black,style=filled,label="R6\n (cov=0.273) \n (G= 0.485) \n (CPorter=1.000)",tooltip="Rule6:  IF Color is Amber OR Brown AND Strength is Session OR Standard THEN Class is Porter (cov=0.273 ; G= 0.485 ; CPorter=1.000)"];
