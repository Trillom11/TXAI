	name=FINGRAM; ratio=auto; size="10,10"; overlap="scale"; nodesep=0.3; center=true; truecolor=true;

	Rule1 [shape=circle,height=3.750,width=3.750,fixedsize=true,peripheries=2,color="#d3d3d3",fillcolor="#d3d3d3",fontsize=15.399999618530273,fontcolor=black,style=filled,label="R1\n (cov=0.275) \n (G= 0.280) \n (CBlanche=1.000)",tooltip="Rule1:  IF Color is Pale AND Bitterness is Low THEN Class is Blanche (cov=0.275 ; G= 0.280 ; CBlanche=1.000)"];
	Rule2 [shape=circle,height=3.875,width=3.875,fixedsize=true,peripheries=2,color="#008000",fillcolor="#008000",fontsize=15.399999618530273,fontcolor=black,style=filled,label="R2\n (cov=0.287) \n (G= 0.249) \n (CPilsner=1.000)",tooltip="Rule2:  IF Color is Pale AND Bitterness is High THEN Class is Pilsner (cov=0.287 ; G= 0.249 ; CPilsner=1.000)"];
	Rule3 [shape=circle,height=2.525,width=2.525,fixedsize=true,peripheries=2,color="#87cefa",fillcolor="#87cefa",fontsize=13.600000381469727,fontcolor=black,style=filled,label="R3\n (cov=0.152) \n (G= 0.708) \n (CIPA=0.980)",tooltip="Rule3:  IF Color is Straw OR Amber AND Strength is High THEN Class is IPA (cov=0.152 ; G= 0.708 ; CIPA=0.980)"];
